---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Engineering Portfolio | Fer Catana">
<main >
        <a href="/" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
            Back to Home
        </a>
        <section class="intro" style="text-align: center; margin: 0 auto; display: flex; flex-direction: column; align-items: center;">
            <h1>Engineering <strong>Portfolio</strong>.</h1>
            <p style="color: var(--text-muted); font-size: 1.1rem; margin-top: 1rem; line-height: 1.6; max-width: 600px;">Hi</p>
        </section>

        <section class="construction-message" style="text-align: center; margin-top: 4rem; padding: 4rem 2rem; background: var(--glass-bg); border: 1px dashed var(--text-muted); border-radius: 16px;">
            <div style="font-size: 4rem; margin-bottom: 1rem;">🚧</div>
            <h2 style="font-size: 2rem; margin-bottom: 1rem; color: var(--text-main);">Under Construction</h2>
            <p style="font-size: 1.1rem; color: var(--text-muted); max-width: 600px; margin: 0 auto;">Check back soon!</p>
        </section>
    </main>
</Layout>
