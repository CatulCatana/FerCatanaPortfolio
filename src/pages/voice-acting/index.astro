---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Voice Acting | Fer Catana">
<main >
        <a href="/FerCatanaPortfolio/" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
            Volver al Inicio
        </a>

        <div class="project-header" style="text-align: center;">
            <h1 class="project-title" style="font-size: 3.5rem;">Fernando Catana</h1>
            <div class="project-meta" style="justify-content: center;">
                <span>Actor de Doblaje/Voz</span>
            </div>
        </div>

        <div class="project-content">
            <div style="background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 16px; padding: 2.5rem; margin-bottom: 4rem;">
                <h3 style="margin-bottom: 1.5rem; color: var(--text-main); font-size: 1.5rem;">Mi perfil</h3>
                <p style="color: var(--text-muted); margin-bottom: 1.5rem; font-size: 1.1rem;">Personajes desde 1 loop en adelante, ambientes, dobletes, tripletes.</p>
                <ul class="voice-list" style="margin-bottom: 1.5rem;">
                    <li><strong>Edad:</strong> <span id="dynamic-age">24</span> años</li>
                    <script>
                        const birthDate = new Date('2001-11-24');
                        const today = new Date();
                        let age = today.getFullYear() - birthDate.getFullYear();
                        const m = today.getMonth() - birthDate.getMonth();
                        if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
                            age--;
                        }
                        const ageElement = document.getElementById('dynamic-age');
                        if (ageElement) {
                            ageElement.textContent = age.toString();
                        }
                    </script>
                    <li><strong>Rango:</strong> 17-25</li>
                    <li><strong>Voz:</strong> Media</li>
                    <li><strong>Sindicato:</strong> Libre</li>
                    <li><strong>Grabación:</strong>Remoto, Presencial Negociable</li>
                    <li><strong>Ubicación:</strong> Veracruz, México</li>
                </ul>
            </div>

            <!-- Demos Section -->
            <div class="voice-section">
                <h2 style="margin-bottom: 1.5rem;">🎙️ Demo de Voz</h2>
                
                <div style="background: rgba(0,0,0,0.3); border: 1px dashed var(--text-muted); padding: 3rem; text-align: center; border-radius: 12px; color: var(--text-muted);">
                    <p style="font-size: 1.5rem; margin-bottom: 0.5rem;">🚧 Bajo Construcción 🚧</p>
                    <p style="font-size: 1.1rem;">Vuelva pronto</p>
                </div>
            </div>

            <!-- Personajes Section -->
            <div class="voice-section">
                <h2>🎭 Personajes</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem;">
                    <!-- Placeholder 1 -->
                    <div>
                        <div style="background: var(--glass-bg); border: 1px dashed var(--text-muted); border-radius: 12px; aspect-ratio: 3/4; display: flex; align-items: center; justify-content: center; color: var(--text-muted);">
                            <span>[ Imagen Placeholder ]</span>
                        </div>
                        <p style="margin-top: 1rem; color: var(--text-main); font-weight: 600; text-align: center;">Personaje 1</p>
                    </div>
                    <!-- Placeholder 2 -->
                    <div>
                        <div style="background: var(--glass-bg); border: 1px dashed var(--text-muted); border-radius: 12px; aspect-ratio: 3/4; display: flex; align-items: center; justify-content: center; color: var(--text-muted);">
                            <span>[ Imagen Placeholder ]</span>
                        </div>
                        <p style="margin-top: 1rem; color: var(--text-main); font-weight: 600; text-align: center;">Personaje 2</p>
                    </div>
                    <!-- Placeholder 3 -->
                    <div>
                        <div style="background: var(--glass-bg); border: 1px dashed var(--text-muted); border-radius: 12px; aspect-ratio: 3/4; display: flex; align-items: center; justify-content: center; color: var(--text-muted);">
                            <span>[ Imagen Placeholder ]</span>
                        </div>
                        <p style="margin-top: 1rem; color: var(--text-main); font-weight: 600; text-align: center;">Personaje 3</p>
                    </div>
                </div>
            </div>

            <!-- Equipment Section -->
            <div class="voice-section">
                <h2>🎧 Home Studio & Equipo</h2>
                <img src="https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?auto=format&fit=crop&q=80&w=1200" alt="Home Studio Treatment" style="width: 100%; border-radius: 12px; margin-bottom: 1.5rem;">
                <ul class="voice-list" id="equipment-list">
                    <li><strong>Micrófono:</strong> Audio-Technica AT2035</li>
                    <li><strong>Interfaz de Audio:</strong> Focusrite Scarlett Solo (3ra Generación)</li>
                    <li><strong>Cable XLR:</strong> Shure C25J</li>
                    <li><strong>Conectividad:</strong> Internet Simétrico de 120 Mbps, conectado por cable ethernet.</li>
                </ul>
            </div>

            <!-- Wiki Section -->
            <div style="background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 12px; padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: space-between; margin-top: 2rem; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <h3 style="color: var(--text-main); margin-bottom: 0.2rem; font-size: 1.1rem;">Doblaje Wiki</h3>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">Conoce mi filmografía completa y proyectos.</p>
                </div>
                <a href="https://doblaje.fandom.com/es/wiki/Fernando_Catana" target="_blank" style="padding: 0.5rem 1.2rem; border: 1px solid var(--glass-border); color: var(--text-main); border-radius: 8px; font-size: 0.9rem; font-weight: 600; text-decoration: none; background: rgba(255,255,255,0.03);">
                    Ver Perfil ↗
                </a>
            </div>

        </div>
    </main>
</Layout>
