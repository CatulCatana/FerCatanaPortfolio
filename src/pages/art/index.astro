---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Art Portfolio | Fer Catana">
<main >
        <a href="/FerCatanaPortfolio/" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
            Back to Home
        </a>
        <section class="intro" style="text-align: center; margin: 0 auto 4rem auto; display: flex; flex-direction: column; align-items: center;">
            <h1>Art <strong>Portfolio</strong>.</h1>
            <p style="color: var(--text-muted); font-size: 1.1rem; margin-top: 1rem; line-height: 1.8; max-width: 800px;">I am a Visual Developer and 3D Generalist specialized in hard-surface modeling, technical texturing, and stylized art direction. My work ranges from meticulous prop and environment creation to full visual development of animation IPs (Character Design, Storyboarding, and Pitch Bibles). I am passionate about blending technical rigor with nostalgic aesthetics (low-poly/retro) and cinematic lighting to tell stories through every image.</p>
        </section>

        <section class="grid">
            <a href="/FerCatanaPortfolio/iwdh-pitch/" class="card">
                <div class="card-image-container">
                    <img src="/FerCatanaPortfolio/assets/iwdh-pitch/1.png" alt="IWDH Pitch" class="card-img">
                    <div class="card-overlay">
                        <span class="card-category">Pitch Document</span>
                    </div>
                </div>
                <h2 class="card-title">IWDH Pitch</h2>
            </a>

            <a href="/FerCatanaPortfolio/archives/2026-h1/" class="card">
                <div class="card-image-container">
                    <img src="/FerCatanaPortfolio/assets/2026-h1/Bike Texturing, model by @Andrei Milin.png" alt="First Half of 2026" class="card-img">
                    <div class="card-overlay">
                        <span class="card-category">Portfolio</span>
                    </div>
                </div>
                <h2 class="card-title">First Half of 2026</h2>
            </a>

            <div class="card" style="cursor: not-allowed; opacity: 0.6;">
                <div class="card-image-container">
                    <div class="card-img" style="background-color: #222225; width: 100%; height: 100%;"></div>
                    <div class="card-overlay">
                        <span class="card-category">Hiatus</span>
                    </div>
                </div>
                <h2 class="card-title">2025 Archive</h2>
            </div>

            <a href="/FerCatanaPortfolio/archives/2024/" class="card">
                <div class="card-image-container">
                    <img src="/FerCatanaPortfolio/assets/2024-archive/Procedural Metal and rust Material.jpeg" alt="2024 Archive" class="card-img">
                    <div class="card-overlay">
                        <span class="card-category">Archive</span>
                    </div>
                </div>
                <h2 class="card-title">2024 Archive</h2>
            </a>

            <a href="/FerCatanaPortfolio/archives/2023/" class="card">
                <div class="card-image-container">
                    <img src="/FerCatanaPortfolio/assets/2023-archive/Stylized Bass.jpeg" alt="2023 Archive" class="card-img">
                    <div class="card-overlay">
                        <span class="card-category">Archive</span>
                    </div>
                </div>
                <h2 class="card-title">2023 Archive</h2>
            </a>

            <a href="/FerCatanaPortfolio/archives/2022/" class="card">
                <div class="card-image-container">
                    <img src="/FerCatanaPortfolio/assets/2022-archive/Gunbuster Commision.jpeg" alt="2022 Archive" class="card-img">
                    <div class="card-overlay">
                        <span class="card-category">Archive</span>
                    </div>
                </div>
                <h2 class="card-title">2022 Archive</h2>
            </a>

            <a href="/FerCatanaPortfolio/archives/2021/" class="card">
                <div class="card-image-container">
                    <img src="/FerCatanaPortfolio/assets/2021-archive/45 ACP.jpg" alt="2021 Archive" class="card-img">
                    <div class="card-overlay">
                        <span class="card-category">Archive</span>
                    </div>
                </div>
                <h2 class="card-title">2021 Archive</h2>
            </a>
        </section>
    </main>
</Layout>
