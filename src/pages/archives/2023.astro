---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="2023 Archive | Fer Catana">
<main >
        <a href="/FerCatanaPortfolio/art/" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
            Volver a Proyectos
        </a>

        <div class="project-header">
            <h1 class="project-title" style="font-size: 3.5rem;">2023 Archive</h1>
            <div class="project-meta">
                <span>Year: 2023</span>
                <span>Selection of the best artworks from 2023</span>
            </div>
        </div>

        <div class="project-content">
            <!-- Galería de Imágenes -->
            <div class="gallery" style="display: flex; flex-direction: column; gap: 4rem; padding-bottom: 4rem;">

                <figure style="margin: 0 0 4rem 0;">
                    <img src="/FerCatanaPortfolio/assets/2023-archive/Jake the Dog.png" alt="Jake the Dog" style="width: 100%; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                    <figcaption style="color: var(--text-muted); margin-top: 0.8rem; text-align: center; font-size: 1rem; font-style: italic;">Jake the Dog</figcaption>
                </figure>

                <figure style="margin: 0 0 4rem 0;">
                    <img src="/FerCatanaPortfolio/assets/2023-archive/Bulma.gif" alt="Bulma" style="width: 100%; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                    <figcaption style="color: var(--text-muted); margin-top: 0.8rem; text-align: center; font-size: 1rem; font-style: italic;">NDS Bulma</figcaption>
                </figure>

                <figure style="margin: 0 0 4rem 0;">
                    <img src="/FerCatanaPortfolio/assets/2023-archive/PS1 Bocchi the Rock.png" alt="PS1 Bocchi the Rock" style="width: 100%; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                    <figcaption style="color: var(--text-muted); margin-top: 0.8rem; text-align: center; font-size: 1rem; font-style: italic;">PS1 Bocchi the Rock</figcaption>
                </figure>

                <figure style="margin: 0 0 4rem 0;">
                    <img src="/FerCatanaPortfolio/assets/2023-archive/Stylized Bass.jpeg" alt="Stylized Bass" style="width: 100%; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                    <figcaption style="color: var(--text-muted); margin-top: 0.8rem; text-align: center; font-size: 1rem; font-style: italic;">Stylized Bass</figcaption>
                </figure>

                <figure style="margin: 0 0 4rem 0;">
                    <img src="/FerCatanaPortfolio/assets/2023-archive/Unused ps2 Gawr Gura Model.png" alt="Unused ps2 Gawr Gura Model" style="width: 100%; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                    <figcaption style="color: var(--text-muted); margin-top: 0.8rem; text-align: center; font-size: 1rem; font-style: italic;">Unused ps2 Gawr Gura Model</figcaption>
                </figure>

                <figure style="margin: 0 0 4rem 0;">
                    <img src="/FerCatanaPortfolio/assets/2023-archive/ZX Spectrum Inspired Backgrounds for a Short Visual Novel.png" alt="ZX Spectrum Inspired Backgrounds for a Short Visual Novel" style="width: 100%; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                    <figcaption style="color: var(--text-muted); margin-top: 0.8rem; text-align: center; font-size: 1rem; font-style: italic;">ZX Spectrum Inspired Backgrounds for a Short Visual Novel</figcaption>
                </figure>

                <figure style="margin: 0 0 4rem 0;">
                    <img src="/FerCatanaPortfolio/assets/2023-archive/Door Animation.gif" alt="Door Animation" style="width: 100%; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                    <figcaption style="color: var(--text-muted); margin-top: 0.8rem; text-align: center; font-size: 1rem; font-style: italic;">Door Animation</figcaption>
                </figure>

            </div>
        </div>
    </main>
</Layout>
